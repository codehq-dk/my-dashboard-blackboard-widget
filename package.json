{
    "name": "mydashboard",
    "scripts": {
        "build": "webpack --mode production",
        "watch": "webpack --mode development --watch",
        "build-sass": "sass ./sass/:./assets/css/ --no-source-map --style compressed",
        "watch-sass": "sass ./sass/:./assets/css/ --no-source-map --watch",
        "format": "prettier --write typescript/**/*.{js,jsx,ts,tsx}",
        "lint": "eslint typescript/**/*.{js,jsx,ts,tsx}",
        "fix-lint": "eslint --fix typescript/**/*.{js,jsx,ts,tsx}"
    },
    "devDependencies": {
        "css-loader": "^6.8.1",
        "eslint": "^8.55.0",
        "eslint-config-airbnb-typescript-prettier": "^5.0.0",
        "eslint-plugin-no-jquery": "^2.7.0",
        "mini-css-extract-plugin": "^2.7.6",
        "prettier": "^2.4.1",
        "sass": "^1.69.5",
        "sass-loader": "^13.3.2",
        "ts-loader": "^9.5.1",
        "tsconfig-paths-webpack-plugin": "^4.1.0",
        "typescript": "^4.1.3",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
        "webpack-manifest-plugin": "^6.0.1"
    },
    "dependencies": {
        "preact": "^10.19.2"
    },
    "eslintConfig": {
        "extends": "preact"
    }
}
